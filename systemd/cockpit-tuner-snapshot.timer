# Copied by install.sh unchanged: this file carries no substitution tokens and
# needs no rendering. It still goes through the same refusal check as the
# service, because a timer that one day grows an ExecStart should fail loudly
# rather than be installed with a token left in it.
[Unit]
Description=Hourly cockpit-tuner settings snapshot

[Timer]
OnCalendar=hourly
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
